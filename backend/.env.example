BASE_URL=http://localhost:5173
SECRET_KEY=change-me-long-random-string
DATA_DIR=./data
# Set in Docker to the built frontend folder
FRONTEND_DIST=
# Only for split hosting (comma-separated origins)
CORS_ORIGINS=
WORKER_COUNT=3
MAX_BROWSER_PAGES=3
DOMAIN_MIN_GAP_SECONDS=10
CONFIRM_REFETCH=true
ALLOW_DEMO_PAGE=true
ADMIN_EMAIL=
# Testing only: treat minutes as seconds
DEBUG_FAST_SCHEDULE=false

# smtp | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail App Password
SMTP_PASSWORD=
SMTP_FROM=ChangeWatch <you@gmail.com>
RESEND_API_KEY=

# Optional app-wide Telegram bot
TELEGRAM_BOT_TOKEN=

# Optional AI summaries
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
